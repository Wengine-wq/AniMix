# Public build configuration only. Never add an OAuth client secret here.
# Optional public overrides for a custom Shikimori OAuth application.
# Official AniMix builds already contain safe production defaults.
SHIKIMORI_CLIENT_ID=your_public_client_id
SHIKIMORI_REDIRECT_URI=https://your-domain.example/callback
SHIKIMORI_OAUTH_PROXY_URL=https://your-worker.example.workers.dev
