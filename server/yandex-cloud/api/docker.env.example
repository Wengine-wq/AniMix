# Domain (or free subdomain such as one from duckdns.org) pointing at this VM.
API_DOMAIN=api.example.ru
POSTGRES_PASSWORD=change-me-long-random

# Same values as the Yandex Cloud Function. GOOGLE_REDIRECT_URI must use
# API_DOMAIN and be added to the Google OAuth client's redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.ru/v1/auth/google/callback
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
# Must stay identical to the current one, or existing sessions stop working.
AUTH_TOKEN_PEPPER=

# Optional: any S3-compatible bucket for profile avatars and banners.
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_REGION=
MEDIA_PUBLIC_BASE_URL=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
