# Non-secret runtime values. These are supplied to Cloud Functions by deploy.ps1.
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/FOLDER_ID/DATABASE_ID
MEDIA_BUCKET=animix-profile-media
MEDIA_PUBLIC_BASE_URL=https://storage.yandexcloud.net/animix-profile-media
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=https://YOUR_GATEWAY_ID.apigw.yandexcloud.net/v1/auth/google/callback
SHIKIMORI_CLIENT_ID=YOUR_PUBLIC_SHIKIMORI_CLIENT_ID
ALLOWED_APP_RETURN_URI=animix://oauth/callback
ANIMIX_WEB_ORIGIN=https://animix.app

# Keep the following ONLY in Yandex Lockbox, never in this file or the app.
# GOOGLE_CLIENT_SECRET
# SHIKIMORI_CLIENT_SECRET
# AUTH_TOKEN_PEPPER
# MEDIA_ACCESS_KEY_ID
# MEDIA_SECRET_ACCESS_KEY
