# /opt/animix/.env — deploy.ps1 writes it from the Yandex Cloud Function and Lockbox.
# Fill in by hand only when deploying without `yc`.
API_DOMAIN=185-1-2-3.sslip.io
POSTGRES_PASSWORD=change-me-long-random

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must use API_DOMAIN and be listed in the Google OAuth client's redirect URIs.
GOOGLE_REDIRECT_URI=https://185-1-2-3.sslip.io/v1/auth/google/callback
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
# Must stay identical to the current one, or existing sessions stop working.
AUTH_TOKEN_PEPPER=

ALLOWED_APP_RETURN_URI=animix://oauth/callback
ANIMIX_WEB_ORIGIN=https://animix.app

# Profile avatars and banners (S3-compatible, currently Yandex Object Storage).
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
