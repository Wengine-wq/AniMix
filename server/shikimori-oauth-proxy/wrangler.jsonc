{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "animix-shikimori-oauth",
	"main": "worker.ts",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "animix-users",
			"database_id": "fdbc0710-b47a-4941-986d-bd8a7b8a3609",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"SHIKIMORI_CLIENT_ID": "NuL115GhQetODbWxWIKOKEt9E2IMtUqGkY9zdQacpBM",
		"ANIMIX_PROXY_ORIGIN": "https://animix.app",
		"GOOGLE_CLIENT_ID": "783379635785-f08al1ugu2qd6hrkpa20lshs7molc6b8.apps.googleusercontent.com",
		"GOOGLE_REDIRECT_URI": "https://animix-shikimori-oauth.shikimori-oauth-proxy.workers.dev/v1/auth/google/callback"
	},
	"secrets": {
		"required": [
			"SHIKIMORI_CLIENT_SECRET",
			"AUTH_TOKEN_PEPPER",
			"GOOGLE_CLIENT_SECRET"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
